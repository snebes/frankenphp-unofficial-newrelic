# =============================================================================
# Dockerfile.zts-build
# Build only the New Relic PHP extension (newrelic.so) with ZTS support.
#
# Run from the root of the merged agent source tree (see release.yaml):
#   docker buildx build -f Dockerfile.zts-build --target package \
#     --build-arg PHP_VERSION=8.4 --build-arg BUILD_NUMBER=40 \
#     --output type=local,dest=out .
# =============================================================================

ARG PHP_VERSION=8.4
ARG PHP_IMAGE_SUFFIX=-zts-bookworm
ARG PCRE_VERSION=8.45

FROM php:${PHP_VERSION}${PHP_IMAGE_SUFFIX} AS builder

ARG PCRE_VERSION
ARG BUILD_NUMBER=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf automake bzip2 gcc libtool make pkg-config \
    libprotobuf-c-dev protobuf-c-compiler \
    && rm -rf /var/lib/apt/lists/*

# The agent needs PCRE1, which Debian Trixie+ no longer ships; build it statically.
RUN curl -fsSL "https://downloads.sourceforge.net/project/pcre/pcre/${PCRE_VERSION}/pcre-${PCRE_VERSION}.tar.bz2" \
    | tar -xj -C /tmp \
    && cd "/tmp/pcre-${PCRE_VERSION}" \
    && ./configure --prefix=/opt/pcre --enable-utf --enable-unicode-properties \
       --enable-static --disable-shared --disable-cpp \
    && make -j"$(nproc)" \
    && make install \
    && ln -sfn lib/libpcre.a /opt/pcre/libpcre.a \
    && rm -rf "/tmp/pcre-${PCRE_VERSION}"

# config.m4 links -L$PCRE_PREFIX -l:libpcre.a; axiom/Makefile calls pcre-config.
ENV PCRE_PREFIX=/opt/pcre
ENV PATH="/opt/pcre/bin:${PATH}"

WORKDIR /usr/src/newrelic-php-agent
COPY . .

RUN make agent -j"$(nproc)" OPTIMIZE=1 PCRE_STATIC=yes BUILD_NUMBER="${BUILD_NUMBER}"

FROM scratch AS package

COPY --from=builder /usr/src/newrelic-php-agent/agent/modules/newrelic.so /newrelic.so
